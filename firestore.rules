rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own user documents
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Comment rules for the discussion forum
    match /comments/{commentId} {
      // Allow authenticated users to read all comments
      allow read: if true;
      
      // Allow authenticated users to create new comments
      // but ensure they can only set their own userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow users to update only their own comments
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow users to delete only their own comments
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Other existing collections (favorites, etc.)
    match /favoriteCoins/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Portföy öğeleri güvenlik kuralları - düzeltildi
    match /portfolios/{portfolioId} {
      // Kullanıcılar kendi portföy öğelerini okuyabilir
      allow read: if request.auth != null && (
        // Belge ID'si userId ile başlıyorsa veya userId alanı eşleşiyorsa
        portfolioId.matches(request.auth.uid + '_.*') || 
        (resource.data.userId == request.auth.uid)
      );
      
      // Kullanıcılar kendi portföy öğelerini oluşturabilir
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Kullanıcılar kendi portföy öğelerini güncelleyebilir
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Kullanıcılar kendi portföy öğelerini silebilir
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Cüzdan güvenlik kuralları - düzeltildi
    match /wallets/{walletId} {
      // Kullanıcılar kendi cüzdanlarını okuyabilir
      allow read: if request.auth != null && (
        walletId == request.auth.uid || 
        (resource.data.userId == request.auth.uid)
      );
      
      // Kullanıcılar kendi cüzdanlarını oluşturabilir ve güncelleyebilir
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // İşlemler için güvenlik kuralları - düzeltildi
    match /transactions/{transactionId} {
      // Kullanıcılar kendi işlemlerini okuyabilir
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
      );
      
      // Kullanıcılar yeni işlem oluşturabilir
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Kullanıcılar kendi işlemlerini silebilir
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // İşlemler değiştirilemez
      allow update: if false;
    }
  }
} 