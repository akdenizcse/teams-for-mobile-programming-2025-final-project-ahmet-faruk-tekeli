rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own user documents
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Comment rules for the discussion forum
    match /comments/{commentId} {
      // Allow authenticated users to read all comments
      allow read: if true;
      
      // Allow authenticated users to create new comments
      // but ensure they can only set their own userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow users to update only their own comments
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow users to delete only their own comments
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Other existing collections (favorites, etc.)
    match /favoriteCoins/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Portföy öğeleri güvenlik kuralları
    match /portfolios/{portfolioId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Cüzdan güvenlik kuralları
    match /wallets/{walletId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // İşlemler için güvenlik kuralları
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false; // İşlemler değiştirilemez
    }
  }
} 